#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define L0 0
#define L1 1
#define L2 2
#define L3 3
#define L4 4

/ {
    macros {
        /* Bandicam capture: Ctrl+Shift+Alt+S (with hold delay, as in the original) */
        bndc: bndc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <100>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT &kp LALT>
                , <&macro_tap &kp S>
                , <&macro_release &kp LALT &kp LSHFT &kp LCTRL>;
        };

        /* Always-on-top toggle: Ctrl+Win+T (matches the original C code, not its comment) */
        tgtp: tgtp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <100>;
            bindings
                = <&macro_press &kp LCTRL &kp LGUI>
                , <&macro_tap &kp T>
                , <&macro_release &kp LGUI &kp LCTRL>;
        };

        /* IME: Ctrl+Shift+1, then Lang1 (Kana) */
        kana: kana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <50>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp N1>
                , <&macro_release &kp LSHFT &kp LCTRL>
                , <&macro_tap &kp LANG1>;
        };

        /* IME: Ctrl+Shift+1, then Lang2 (Romaji) */
        roma: roma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <50>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp N1>
                , <&macro_release &kp LSHFT &kp LCTRL>
                , <&macro_tap &kp LANG2>;
        };

        /* IME: Ctrl+Shift+1, Lang1, then Ctrl+Shift+2 (Hangul) */
        hngl: hngl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <50>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp N1>
                , <&macro_release &kp LSHFT &kp LCTRL>
                , <&macro_tap &kp LANG1>
                , <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp N2>
                , <&macro_release &kp LSHFT &kp LCTRL>;
        };

        /*
         * Mouse turbo click.
         * ZMK has no toggling auto-repeat behavior, so this fires a fixed burst
         * of 10 left clicks per press instead. Adjust tap-ms/wait-ms for speed.
         */
        turbo: turbo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings
                = <&macro_tap &mkp LCLK &mkp LCLK &mkp LCLK &mkp LCLK &mkp LCLK>
                , <&macro_tap &mkp LCLK &mkp LCLK &mkp LCLK &mkp LCLK &mkp LCLK>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

/* LAYER 0 - base
 * +------+------+------+------+------+------+             +------+------+------+------+------+------+
 * |   `  |   1  |   2  |   3  |   4  |   5  |             |   6  |   7  |   8  |   9  |   0  |  -   |
 * +------+------+------+------+------+------+             +------+------+------+------+------+------+
 * | Tab  |   Q  |   W  |   E  |   R  |   T  |             |   Y  |   U  |   I  |   O  |   P  |Enter |
 * +------+------+------+------+------+------+             +------+------+------+------+------+------+
 * | MO(2)|   A  |   S  |   D  |   F  |   G  |             |   H  |   J  |   K  |   L  |   ;  |   '  |
 * +------+------+------+------+------+------+------+------+------+------+------+------+------+------+
 * | Shft |   Z  |   X  |   C  |   V  |   B  | Spc  | Spc  |   N  |   M  |   ,  |   .  |   /  | Shft |
 * +------+------+------+------+------+------+------+------+------+------+------+------+------+------+
 * | Ctrl | Gui  | Alt  | Alt  | MO(3)| Spc  | Spc  | Spc  | Bksp | MO(3)| MO(4)| MO(1)| App  | Ctrl |
 * +------+------+------+------+------+------+------+------+------+------+------+------+------+------+
 */
        layer0 {
            bindings = <
&kp GRAVE  &kp N1     &kp N2     &kp N3     &kp N4     &kp N5                           &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp MINUS
&kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T                            &kp Y      &kp U      &kp I      &kp O      &kp P      &kp ENTER
&mo L2     &kp A      &kp S      &kp D      &kp F      &kp G                            &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
&kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B      &kp SPACE  &kp SPACE  &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RSHFT
&kp LCTRL  &kp LGUI   &kp LALT   &kp LALT   &mo L3     &kp SPACE  &kp SPACE  &kp SPACE  &kp BSPC   &mo L3     &mo L4     &mo L1     &kp K_APP  &kp RCTRL
            >;
        };

/* LAYER 1 - function / navigation
 * +------+------+------+------+------+------+             +------+------+------+------+------+------+
 * | F12  |  F1  |  F2  |  F3  |  F4  |  F5  |             |  F6  |  F7  |  F8  |  F9  | F10  | F11  |
 * +------+------+------+------+------+------+             +------+------+------+------+------+------+
 * |      |      |  (   |  )   |  -   |  =   |             |      |PrtScn|ScrLk | Paus |      |      |
 * +------+------+------+------+------+------+             +------+------+------+------+------+------+
 * |      |      |  [   |  ]   |  \   |Enter |             |      | Ins  | Home | PgUp | KANA | HNGL |
 * +------+------+------+------+------+------+------+------+------+------+------+------+------+------+
 * |      |Ctrl+Z|Ctrl+X|Ctrl+C|Ctrl+V|      |      |      |      | Del  | End  | PgDn | ROMA |      |
 * +------+------+------+------+------+------+------+------+------+------+------+------+------+------+
 * |      |      |      |      |      |      |      |      |      |      |      |      |      |      |
 * +------+------+------+------+------+------+------+------+------+------+------+------+------+------+
 */
        layer1 {
            bindings = <
&kp F12          &kp F1           &kp F2           &kp F3           &kp F4           &kp F5                                             &kp F6           &kp F7           &kp F8           &kp F9           &kp F10          &kp F11
&trans           &trans           &kp LPAR         &kp RPAR         &kp MINUS        &kp EQUAL                                          &trans           &kp PSCRN        &kp SLCK         &kp PAUSE_BREAK  &trans           &trans
&trans           &trans           &kp LBKT         &kp RBKT         &kp BSLH         &kp ENTER                                          &trans           &kp INS          &kp HOME         &kp PG_UP        &kana            &hngl
&trans           &kp LC(Z)        &kp LC(X)        &kp LC(C)        &kp LC(V)        &trans           &trans           &trans           &trans           &kp DEL          &kp END          &kp PG_DN        &roma            &trans
&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
            >;
        };

/* LAYER 2 - mouse / numpad
 * +------+------+------+------+------+------+             +------+------+------+------+------+------+
 * |      | MS B1| MS B3| MS B2|      |      |             |      | #Lk  |   /  |   *  |  -   |  +   |
 * +------+------+------+------+------+------+             +------+------+------+------+------+------+
 * | Esc  |WH Lft|MS Up |WH Rgt|WH Up |      |             |      |  7   |  8   |  9   |  +   | Caps |
 * +------+------+------+------+------+------+             +------+------+------+------+------+------+
 * |      |MS Lft|MS Dwn|MS Rgt|WH Dwn|      |             |      |  4   |  5   |  6   |  +   |      |
 * +------+------+------+------+------+------+------+------+------+------+------+------+------+------+
 * |Enter |      |      |      |      |      |      |      |      |  1   |  2   |  3   |  =   |      |
 * +------+------+------+------+------+------+------+------+------+------+------+------+------+------+
 * |      |      |      |      |      |      |      |      |      |  0   |  0   |  .   | Entr |      |
 * +------+------+------+------+------+------+------+------+------+------+------+------+------+------+
 */
        layer2 {
            bindings = <
&trans           &mkp LCLK        &mkp MCLK        &mkp RCLK        &trans           &trans                                             &trans           &kp KP_NUM       &kp KP_DIVIDE    &kp KP_MULTIPLY  &kp KP_MINUS     &kp KP_PLUS
&kp ESC          &msc SCRL_LEFT   &mmv MOVE_UP     &msc SCRL_RIGHT  &msc SCRL_UP     &trans                                             &trans           &kp KP_N7        &kp KP_N8        &kp KP_N9        &kp KP_PLUS      &kp CAPS
&trans           &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_RIGHT  &msc SCRL_DOWN   &trans                                             &trans           &kp KP_N4        &kp KP_N5        &kp KP_N6        &kp KP_PLUS      &trans
&kp ENTER        &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &kp KP_N1        &kp KP_N2        &kp KP_N3        &kp KP_EQUAL     &trans
&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &kp KP_N0        &kp KP_N0        &kp KP_DOT       &kp KP_ENTER     &trans
            >;
        };

/* LAYER 3 - arrows / shortcuts
 * +------+------+------+------+------+------+             +------+------+------+------+------+------+
 * | F12  |  F1  |  F2  |  F3  |  F4  |  F5  |             |  F6  |  F7  |  F8  |  F9  | F10  | F11  |
 * +------+------+------+------+------+------+             +------+------+------+------+------+------+
 * |      |      |      |  Up  |      | TGTP |             |      |      |  Up  |  [   |  ]   |      |
 * +------+------+------+------+------+------+             +------+------+------+------+------+------+
 * |      |TURBO | Left | Down |Right |      |             |      | Left | Down |Right |      | Esc  |
 * +------+------+------+------+------+------+------+------+------+------+------+------+------+------+
 * |      |SMenu | Del  | SHRX | BNDC |      |      |      |      |      |      |      |SMenu |      |
 * +------+------+------+------+------+------+------+------+------+------+------+------+------+------+
 * |      |      |      |      |      |      |      |      |      |      |      |      |      |      |
 * +------+------+------+------+------+------+------+------+------+------+------+------+------+------+
 */
        layer3 {
            bindings = <
&kp F12         &kp F1          &kp F2          &kp F3          &kp F4          &kp F5                                          &kp F6          &kp F7          &kp F8          &kp F9          &kp F10         &kp F11
&trans          &trans          &trans          &kp UP          &trans          &tgtp                                           &trans          &trans          &kp UP          &kp LBKT        &kp RBKT        &trans
&trans          &turbo          &kp LEFT        &kp DOWN        &kp RIGHT       &trans                                          &trans          &kp LEFT        &kp DOWN        &kp RIGHT       &trans          &kp ESC
&trans          &kp LS(K_APP)   &kp DEL         &kp LG(LS(Q))   &bndc           &trans          &trans          &trans          &trans          &trans          &trans          &trans          &kp LS(K_APP)   &trans
&trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
            >;
        };

/* LAYER 4 - media / system
 * +------+------+------+------+------+------+             +------+------+------+------+------+------+
 * | BT0  | BT1  | BT2  | BT3  | BT4  |      |             |      |      |      |RGB Tg| Brt- | Brt+ |
 * +------+------+------+------+------+------+             +------+------+------+------+------+------+
 * |      |      |      |      |      |      |             |      |      |      | Mute | Vol- | Vol+ |
 * +------+------+------+------+------+------+             +------+------+------+------+------+------+
 * |      |      |      |      |      |      |             |      |      |      | Prev |Ply/Ps| Next |
 * +------+------+------+------+------+------+------+------+------+------+------+------+------+------+
 * |      |      |      |      |      |      |      |      |      |      |      |      |      |      |
 * +------+------+------+------+------+------+------+------+------+------+------+------+------+------+
 * |      |      |      |      |      |      |      |      |      |      |      |      |      |Reset |
 * +------+------+------+------+------+------+------+------+------+------+------+------+------+------+
 */
        layer4 {
            bindings = <
&bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4     &trans                                             &trans           &trans           &trans           &rgb_ug RGB_TOG  &kp C_BRI_DN     &kp C_BRI_UP
&bt BT_DISC 0    &bt BT_DISC 1    &bt BT_DISC 2    &bt BT_DISC 3    &bt BT_DISC 4    &trans                                             &trans           &trans           &trans           &kp C_MUTE       &kp C_VOL_DN     &kp C_VOL_UP
&bt BT_CLR       &trans           &trans           &trans           &trans           &trans                                             &trans           &trans           &trans           &kp C_PREV       &kp C_PP         &kp C_NEXT
&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
&trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &bootloader
            >;
        };
    };
};
